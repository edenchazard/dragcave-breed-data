{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "trailingComma": "all",
  "singleQuote": true,
  "singleAttributePerLine": true,
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules",
    "coverage",
    "output",
    "src/localBreeds.json",
    "src/fallbackBreeds.json",
    "package.json",
  ]
}
